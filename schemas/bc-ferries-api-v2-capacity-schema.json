{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "BC Ferries API V2 Capacity Routes Response Schema",
    "description": "Schema for the BC Ferries API V2 response from https://bcferriesapi.ca/v2/capacity/",
    "type": "object",
    "properties": {
      "routes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "routeCode": {
              "type": "string"
            },
            "fromTerminalCode": {
              "type": "string"
            },
            "toTerminalCode": {
              "type": "string"
            },
            "sailingDuration": {
              "type": "string"
            },
            "sailings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sailingId": {
                    "type": "string",
                    "pattern": "^bcf:v1:\\d{4}-\\d{2}-\\d{2}:[A-Z0-9]+-[A-Z0-9]+:\\d{4}:\\d{2}$"
                  },
                  "scheduledDepartureAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "scheduledArrivalAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "scheduleSource": {
                    "type": "string"
                  },
                  "scheduleSourceUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "scheduleScrapedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "operationalSource": {
                    "type": "string"
                  },
                  "time": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^(1[0-2]|0?[1-9]):[0-5][0-9] (am|pm)$"
                      }
                    ]
                  },
                  "arrivalTime": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^(1[0-2]|0?[1-9]):[0-5][0-9] (am|pm)$"
                      },
                      {
                        "type": "string",
                        "enum": ["", "...", "Variable"]
                      }
                    ]
                  },
                  "scheduledDepartureTime": {
                    "type": "string",
                    "pattern": "^(1[0-2]|0?[1-9]):[0-5][0-9] (am|pm)$"
                  },
                  "scheduledArrivalTime": {
                    "type": "string",
                    "pattern": "^(1[0-2]|0?[1-9]):[0-5][0-9] (am|pm)$"
                  },
                  "actualDepartureTime": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^(1[0-2]|0?[1-9]):[0-5][0-9] (am|pm)$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "estimatedArrivalTime": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^(1[0-2]|0?[1-9]):[0-5][0-9] (am|pm)$"
                      },
                      {
                        "type": "string",
                        "enum": ["Variable"]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "actualArrivalTime": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^(1[0-2]|0?[1-9]):[0-5][0-9] (am|pm)$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "serviceDate": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "scrapedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "sailingStatus": {
                    "type": "string",
                    "enum": ["future", "past", "current", "cancelled"]
                  },
                  "fill": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "carFill": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "oversizeFill": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "vesselName": {
                    "type": "string"
                  },
                  "vesselStatus": {
                    "type": "string"
                  }
                },
                "required": [
                  "sailingId",
                  "scheduledDepartureAt",
                  "scheduleSource",
                  "scheduleSourceUrl",
                  "scheduleScrapedAt",
                  "operationalSource",
                  "time",
                  "arrivalTime",
                  "scheduledDepartureTime",
                  "actualDepartureTime",
                  "estimatedArrivalTime",
                  "actualArrivalTime",
                  "serviceDate",
                  "scrapedAt",
                  "sailingStatus",
                  "fill",
                  "carFill",
                  "oversizeFill",
                  "vesselName",
                  "vesselStatus"
                ]
              }
            }
          },
          "required": [
            "routeCode",
            "fromTerminalCode",
            "toTerminalCode",
            "sailingDuration",
            "sailings"
          ]
        }
      }
    },
    "required": ["routes"]
  }
